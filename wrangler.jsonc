{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-idp",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "RP_NAME": "Identity",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edge-idp",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
  ],
  "triggers": { "crons": ["17 * * * *"] },
}
