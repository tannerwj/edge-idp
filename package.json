{
  "dependencies": {
    "@sentry/cloudflare": "^11.4.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "hono": "^4.7.0",
    "jose": "^6.0.0"
  },
  "description": "Personal passkey-only OIDC identity provider on Cloudflare Workers + D1",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.0",
    "@e2e-dev/web": "^0.13.0",
    "@tjohnson/abacus": "github:tannerwj/abacus",
    "@types/node": "^26.6.4",
    "cf": "^1.0.0-beta.13",
    "e2e": "^0.18.0",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "license": "MIT",
  "name": "edge-idp",
  "private": true,
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:local": "node scripts/db-migrate.mjs --local",
    "deploy": "node scripts/deploy.mjs",
    "dev": "npm run build:client && cf dev",
    "fmt": "abacus fmt",
    "fmt:check": "abacus fmt --check",
    "gates": "abacus check",
    "seed:admin": "node scripts/seed-admin.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "abc": "abacus abc",
    "size": "abacus size",
    "ratchet": "abacus ratchet",
    "tsc": "abacus tsc",
    "deadcode": "abacus deadcode",
    "secrets": "abacus secrets",
    "cycles": "abacus cycles",
    "dupes": "abacus dupes",
    "todos": "abacus todos",
    "check": "abacus check",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e:local": "node tests/e2e/full.mjs",
    "test:e2e:staging": "E2E_STAGE=staging node tests/e2e/full.mjs",
    "test:e2e:setup": "node tests/e2e/setup.mjs",
    "deploy:check": "npm run build:client && cf deploy --dry-run",
    "staging:deploy": "npm run build:client && cf deploy --mode staging",
    "staging:migrate": "node scripts/db-migrate.mjs --stage=staging"
  },
  "type": "module",
  "version": "0.1.0",
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "Any long random string (12+ characters). You type it once at **/setup** to create the first admin account; the page disappears after that."
      },
      "DB": {
        "description": "Users, passkeys, sessions, clients and the audit log. Migrations run on every deploy."
      },
      "RP_NAME": {
        "description": "The name people see on the sign-in page and in their passkey manager, e.g. `Smith Family ID`."
      },
      "AUTH_LIMITER": {
        "description": "Per-IP rate limit for passkey ceremonies and setup."
      },
      "API_LIMITER": {
        "description": "Per-IP rate limit for token and MCP traffic."
      }
    }
  }
}
