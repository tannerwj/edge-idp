{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.tsx",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/*.e2e.{ts,tsx,js,mjs}",
    "*.config.{ts,js,mjs}",
    ".dependency-cruiser.{js,cjs,mjs}",
    "scripts/**/*.{ts,js,mjs}",
    "src/client/app.ts",
    "tests/e2e/**/*.mjs",
    "tests/security/**/*.mjs"
  ],
  "ignore": [
    "dist/**",
    ".wrangler/**",
    "docs/archive/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "cloudflare"
  ]
}
